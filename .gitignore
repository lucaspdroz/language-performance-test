# Consolidated Multi-Language Project .gitignore

# Rules for Java, Go, Rust, .NET/Visual Studio, and general IDE/OS files.

# 1. Compilation and Build Artifacts (General)

##############################################

# General object files, binaries, and logs

*.exe
*.dll
*.so
*.dylib
*.obj
*.lib
*.pdb
*.o
*.d
*.log
*.tmp
*.meta
*.pch
*.ilk
*.pidb
*.pgc
*.pgd
*.rsp

# 2. Package and Archive Files

##############################################
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# 3. Java Specific

##############################################
*.class
*.ctxt              # BlueJ files
.mtj.tmp/           # Mobile Tools for Java
hs_err_pid* # JVM crash logs
replay_pid*

# 4. Go Specific

##############################################
*.test              # Test binary, built with `go test -c`
*.out               # Go coverage output
go.sum
go.mod

# 5. Rust / Cargo Specific

##############################################
/target/            # Compiled object files and binaries
Cargo.lock          # Only ignore if not building a final application/binary
**/*.rs.bk          # Editor backups

# 6. .NET / Visual Studio Specific

##############################################

# Build Output Directories

[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
x64/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# User-specific files

*.suo
*.user
*.sln.docstates

# NuGet/Dependency

packages/
!packages/repositories.config # Preserve the configuration file

# Visual Studio Cache and Temporary Files

ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.tmp_proj
.builds
*.vspscc
*.vssscc
*.scc
*.svclog
*.dbmdl

# Generated and Tooling Files

*_i.c
*_p.c
*_i.h
*.pgc
*.pgd
*.sbr
*.tlb
*.tli
*.tlh
*.psess
*.vsp
*.vspx
*.gpState
_NCrunch*
Generated_Code/
sql/
*.Cache
ClientBin/

# Publishing and Deployment

publish/
*.Publish.xml
*.pubxml
*.azurePubxml
*.publishsettings
csx/
*.build.csdef
AppPackages/

# Upgrade Reports and Backups

_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
App_Data/*.mdf
App_Data/*.ldf

# ReSharper and Analysis

_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
[Ss]tyle[Cc]op.*
![Ss]tyle[Cc]op.targets

# 7. IDE and Editor Settings

##############################################
.vscode/
.idea/
*.swp
*.swo

# 8. Dependencies and Caches

##############################################
vendor/
/deps/
/tmp/               # cargo-generate temp
/build/             # Custom build directories
/crash-dumps/

# 9. OS Generated Files and Backups

##############################################
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
~$*
*~